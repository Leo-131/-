diff --git a/tests/receipt-patch-generator.test.mjs b/tests/receipt-patch-generator.test.mjs
index b14f9b0..034bd3f 100644
--- a/tests/receipt-patch-generator.test.mjs
+++ b/tests/receipt-patch-generator.test.mjs
@@ -7,0 +8 @@
+import {createHash} from 'node:crypto';
@@ -116,0 +118,54 @@
+const PNG_BYTES=Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aVxkAAAAASUVORK5CYII=','base64');
+const JPEG_BYTES=Buffer.from('','base64');
+function explicitScreenshot(f,{name='fixture-confirmed.jpg',bytes=JPEG_BYTES,hashField='confirmationScreenshotSha256'}={}){
+ const attemptName='fixture-send-attempt-2026-10-13.json',a=JSON.parse(fs.readFileSync(path.join(f.dir,attemptName),'utf8'));
+ const hash=createHash('sha256').update(bytes).digest('hex');
+ if(!name.includes('/')&&!name.includes('\\')&&!name.includes(':'))fs.writeFileSync(path.join(f.dir,name),bytes);
+ a.confirmationScreenshot=name;
+ if(hashField==='receiptEvidence')a.receiptEvidence={screenshotSha256:hash};else if(hashField)a[hashField]=hash;
+ f.put(attemptName,a);return {a,hash,name,attemptName};
+}
+
+test('email explicit PNG/JPEG screenshots preserve actual file and hash in both receipt stores without writes',()=>{
+ for(const [extension,bytes,hashField]of [['png',PNG_BYTES,'confirmationScreenshotSha256'],['jpg',JPEG_BYTES,'confirmationScreenshotSha256'],['jpeg',JPEG_BYTES,'screenshotSha256'],['jpg',JPEG_BYTES,'receiptEvidence']]){
+  const f=fixture(100);try{
+   const proof=explicitScreenshot(f,{name:'fixture-confirmed.'+extension,bytes,hashField}),originals=snapshotFixture(f);
+   const proposal=f.run();assertFixtureUnchanged(f,originals);
+   const files=applyProposal(proposal,originals),key=name=>path.join(f.dir,name).replaceAll('\\','/');
+   const receipt=JSON.parse(files.get(key('confirmed-outreach-2026-10-13.json'))).records.at(-1);
+   const permanent=JSON.parse(files.get(key('autonomous-outreach-results.js')).match(/\n\s*,(\{[^\n]*\})\n\];$/)[1]);
+   const attempt=JSON.parse(files.get(key(proof.attemptName)));
+   for(const row of [receipt,permanent,attempt]){assert.equal(row.confirmationScreenshot,proof.name);assert.equal(row.confirmationScreenshotSha256,proof.hash);}
+   assert.equal(receipt.subject,'FLEXTAIL global brand representation');assert.equal(receipt.mailId,'1_0:fixture-new');
+   assert.equal(receipt.country,proof.a.country);assert.equal(receipt.icp,proof.a.icp);assert.equal(attempt.doNotResend,true);
+  }finally{f.cleanup();}
+ }
+});
+
+test('email explicit screenshot rejects wrong magic, extension, hash, absent file and unsafe basenames without writes',()=>{
+ const cases=[
+  {name:'fixture-confirmed.png',bytes:JPEG_BYTES},{name:'fixture-confirmed.jpg',bytes:PNG_BYTES},
+  {name:'fixture-confirmed.jpeg',bytes:PNG_BYTES},{bytes:Buffer.from([255,216,255])},
+  {bytes:Buffer.from('synthetic text is not an image')},{name:'missing.jpg',missing:true},
+  {hashField:null},{badHash:true},{conflictingHash:true},
+  ...['../outside.jpg','C:/outside.jpg','subdir/image.jpg','..\\outside.jpg','image.jpg:stream','fixture.JPG'].map(name=>({name}))
+ ];
+ for(const item of cases){const f=fixture(100);try{
+  const p=explicitScreenshot(f,item);
+  if(item.missing)fs.unlinkSync(path.join(f.dir,p.name));
+  if(item.badHash||item.conflictingHash)f.put(p.attemptName,{...p.a,...(item.badHash?{confirmationScreenshotSha256:'f'.repeat(64)}:{screenshotSha256:'e'.repeat(64)})});
+  const originals=snapshotFixture(f);
+  assert.throws(f.run,error=>{assert.equal(String(error.stdout),'');return true;},JSON.stringify(item));
+  assertFixtureUnchanged(f,originals);
+ }finally{f.cleanup();}}
+});
+
+test('email legacy screenshot fallback remains unchanged when no explicit screenshot fields exist',()=>{
+ const f=fixture(100);try{
+  const originals=snapshotFixture(f),proposal=f.run();assertFixtureUnchanged(f,originals);
+  assert.match(proposal,/fixture-sent-confirmation-2026-10-13\.png/);
+  assert.doesNotMatch(proposal,/confirmationScreenshotSha256/);
+  fs.unlinkSync(path.join(f.dir,'fixture-sent-confirmation-2026-10-13.png'));
+  assert.throws(f.run,/Saved confirmation screenshot required/);
+ }finally{f.cleanup();}
+});
