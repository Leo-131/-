+  try{
+    const target=new URL(value,url.origin);let decoded=value;
+    // Validate every decoded form, but preserve the original local URL on success.
+    // Encoded slashes/dot segments must not become an external redirect or login loop.
+    for(let depth=0;depth<8;depth++){
+      if(!decoded.startsWith('/')||decoded.startsWith('//')||/[\\\u0000-\u001f\u007f]/.test(decoded))return fallback;
