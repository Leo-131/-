+  assert.equal(h.api.query.get('platform'),'email');assert.equal(h.api.query.get('channel'),'website');assert.equal(h.api.query.get('country'),'Singapore');
+  assert.ok(h.rows().length>0);assert.ok(cellCompanies(h).every(x=>x.startsWith('Alpha')));assert.deepEqual(h.errors,[]);
+ }finally{h.close();}
+});
+
+test('sort, page and reset remain same-page, retain filters and render current URL state',()=>{
+ const h=setup('?view=customers&source=synthetic&sort=company&direction=asc');try{
+  assert.equal(h.rows().length,100);const next=h.shell.querySelector('.cc-pagination a');
+  assert.equal(h.click(next).defaultPrevented,true);assert.equal(new URL(h.w.location.href).searchParams.get('page'),'2');assert.equal(h.rows().length,21);
+  assert.equal(h.api.query.get('source'),'synthetic');
