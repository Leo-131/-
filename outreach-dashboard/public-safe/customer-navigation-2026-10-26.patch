+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {JSDOM,VirtualConsole} from 'jsdom';
+
+const read=file=>fs.readFileSync(new URL('../web/'+file,import.meta.url),'utf8');
+const source=read('command-center.js');
+const fixtures=()=>Array.from({length:121},(_,i)=>Object.freeze({
+ id:'synthetic-'+i,name:'Fixture '+String(i).padStart(3,'0'),
+ company:i===120?'Needle Trading':(i%2?'Alpha':'Beta')+' Shop '+String(i).padStart(3,'0'),
+ country:'Singapore',industry:'Outdoor retail',platform:i%2?'email':'instagram',
+ source:'synthetic',status:'Pending',fitScore:80,
+ updatedAt:'2026-10-'+String(1+i%20).padStart(2,'0')+'T00:00:00Z',
+ website:'https://synthetic-'+i+'.test/',contactUrl:'https://synthetic-'+i+'.test/contact',
+}));
+function setup(search='?view=customers'){
+ const errors=[],vc=new VirtualConsole();vc.on('jsdomError',e=>errors.push(e.message));
+ const dom=new JSDOM('<body><div id="retained-control">retained</div></body>',{url:'https://workspace.test/'+search,runScripts:'outside-only',virtualConsole:vc});
+ const w=dom.window,records=fixtures(),before=JSON.stringify(records),calls={fetch:0,push:0,timeout:0};
+ w.fetch=()=>{calls.fetch++;throw Error('Unexpected fetch');};
+ for(const f of ['outreach-efficiency.js','outreach-engine.js','outreach-analytics.js','report-integrity.js','contact-discovery.js','customer-projection.js','customer-event-ledger.js','customer-state.js'])w.eval(read(f));
+ w.__fixtureRecords=records;w.AUTONOMOUS_OUTREACH_DATA={tasks:[],audit:[],settings:{}};
+ const anchor='  window.exportCurrentReportCsv = exportCurrentReportCsv;';assert.ok(source.includes(anchor));
+ w.eval(source.replace(anchor,`  derivedCache.set('customerRecords', window.__fixtureRecords);
+  window.__navigationTest={customers,customerRecords,applyCustomerFilters,query,
+    installCustomerNavigation:typeof installCustomerNavigation==='function'?installCustomerNavigation:null};return;
+`+anchor));
+ const api=w.__navigationTest,shell=w.document.createElement('div');shell.id='command-center-shell';
+ shell.innerHTML='<aside class="cc-sidebar">sidebar</aside><main class="cc-main">'+api.customers()+'</main><aside class="cc-rail">rail</aside>';
+ w.document.body.appendChild(shell);api.installCustomerNavigation?.(shell);
+ // Inline submit attributes are deliberately not executed by outside-only JSDOM.
+ shell.addEventListener('submit',e=>api.applyCustomerFilters(e));
+ const push=w.history.pushState.bind(w.history);w.history.pushState=(...args)=>{calls.push++;return push(...args);};
+ const snapshot={shell,main:shell.querySelector('.cc-main'),sidebar:shell.querySelector('.cc-sidebar'),rail:shell.querySelector('.cc-rail'),control:w.document.getElementById('retained-control')};
+ return {dom,w,api,records,before,calls,errors,...snapshot,
+  rows:()=>[...shell.querySelectorAll('.cc-table tbody tr')],
+  submit(){const e=new w.Event('submit',{bubbles:true,cancelable:true});shell.querySelector('form').dispatchEvent(e);assert.equal(e.defaultPrevented,true);},
+  click(el,opts={}){const e=new w.MouseEvent('click',{bubbles:true,cancelable:true,button:0,...opts});el.dispatchEvent(e);return e;},
+  close(){dom.window.close();},
+ };
+}
+const cellCompanies=h=>h.rows().map(r=>r.children[1].childNodes[0].textContent);
+function historyMove(h,method){return new Promise((resolve,reject)=>{const timer=setTimeout(()=>reject(Error('Missing popstate')),1000);h.w.addEventListener('popstate',()=>{clearTimeout(timer);resolve();},{once:true});h.w.history[method]();});}
+
+test('typing alone retains rows; submitting updates exact URL and matching rows without document navigation or fetch',()=>{
+ const h=setup();try{
+  const old=h.main.innerHTML;h.w.document.getElementById('customer-search').value='Needle';
+  h.w.document.getElementById('customer-search').dispatchEvent(new h.w.Event('input',{bubbles:true}));
+  assert.equal(h.main.innerHTML,old);assert.equal(h.w.location.search,'?view=customers');
+  h.submit();assert.equal(h.w.location.search,'?view=customers&search=Needle&sort=latestUpdate&direction=desc');
+  assert.deepEqual(cellCompanies(h),['Needle Trading']);assert.equal(h.calls.fetch,0);assert.deepEqual(h.errors,[]);
+  assert.equal(h.w.document.getElementById('command-center-shell'),h.shell);assert.equal(h.shell.querySelector('.cc-main'),h.main);
+ }finally{h.close();}
+});
+
+test('repeated identical submits add no duplicate browser history and preserve every filter value',()=>{
+ const h=setup();try{
+  h.w.document.getElementById('customer-search').value='Alpha';
+  h.w.document.getElementById('customer-channel').value='website';
+  h.w.document.getElementById('customer-platform').value='email';
