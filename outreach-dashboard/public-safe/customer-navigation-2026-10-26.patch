+  assert.equal(h.click(h.shell.querySelector('.cc-reset')).defaultPrevented,true);assert.equal(h.w.location.search,'?view=customers');assert.equal(h.api.query.has('source'),false);
+  assert.equal(h.calls.fetch,0);assert.deepEqual(h.errors,[]);
+ }finally{h.close();}
+});
+
+test('back and forward reread customer URLs without adding history or reinitializing the shell',async()=>{
+ const h=setup();try{
+  h.w.document.getElementById('customer-search').value='Needle';h.submit();
+  h.click(h.shell.querySelector('.cc-reset'));const length=h.w.history.length;
+  await historyMove(h,'back');assert.deepEqual(cellCompanies(h),['Needle Trading']);assert.equal(h.api.query.get('search'),'Needle');
+  await historyMove(h,'forward');assert.equal(h.rows().length,100);assert.equal(h.api.query.has('search'),false);
+  assert.equal(h.w.history.length,length);assert.equal(h.calls.push,2);assert.equal(h.w.document.getElementById('command-center-shell'),h.shell);assert.deepEqual(h.errors,[]);
+ }finally{h.close();}
+});
+
+test('modified clicks, downloads, other views, external origins and paths retain native behaviour',()=>{
+ const h=setup();try{
+  const before=h.main.innerHTML;
+  for(const props of [{ctrlKey:true},{metaKey:true},{shiftKey:true},{altKey:true},{button:1}]){
+   const e=h.click(h.shell.querySelector('.cc-reset'),props);assert.equal(e.defaultPrevented,false);
+  }
+  for(const [href,attrs] of [['https://outside.test/?view=customers',{}],['/elsewhere?view=customers',{}],['?view=customer&contact=synthetic',{}],['?view=workspace',{}],['?view=customers',{target:'_blank'}],['?view=customers',{download:'records.csv'}],['?view=customers#details',{}]]){
+   const a=h.w.document.createElement('a');a.className='cc-reset';a.href=href;Object.assign(a,attrs);h.main.appendChild(a);
+   assert.equal(h.click(a).defaultPrevented,false,href+' '+JSON.stringify(attrs));a.remove();
+  }
+  assert.equal(h.main.innerHTML,before);assert.equal(h.calls.push,0);assert.equal(h.calls.fetch,0);
+ }finally{h.close();}
+});
+
+test('same-page renders reuse memoized data and preserve outer controls and mutation observers',async()=>{
+ const h=setup();try{
+  let mutations=0;const observer=new h.w.MutationObserver(()=>mutations++);observer.observe(h.shell,{childList:true,subtree:true});
+  const memoized=h.api.customerRecords();h.w.document.getElementById('customer-search').value='Needle';h.submit();await Promise.resolve();
+  assert.equal(h.api.customerRecords(),memoized);assert.equal(memoized,h.records);assert.equal(JSON.stringify(h.records),h.before);
+  assert.equal(h.shell.querySelector('.cc-sidebar'),h.sidebar);assert.equal(h.shell.querySelector('.cc-rail'),h.rail);assert.equal(h.w.document.getElementById('retained-control'),h.control);
+  assert.ok(mutations>0);assert.equal(h.calls.fetch,0);observer.disconnect();assert.deepEqual(h.errors,[]);
+ }finally{h.close();}
+});
