+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createDatabase} from '../scripts/local-db.mjs';
+import {developmentTasksRoute} from '../server/development-tasks.mjs';
+import {taskMcp} from '../server/task-mcp.mjs';
+import {planResilientSteps} from '../server/execution-resilience.mjs';
+
+// All tasks, companies and references in this file are synthetic. The default
+// database is in-memory; no production queue, browser or mailbox is accessed.
+const executor='current-codex-plan1';
+const reference='local-only/recovery/verified-session-1';
+const json=(data,status=200)=>Response.json(data,{status});
+const receipts=[
+ {company:'Synthetic confirmed company one',reference:'local-only/receipt/one',kind:'sent_verified'},
+ {company:'Synthetic confirmed company two',reference:'local-only/receipt/two',kind:'sent_verified'}
+];
+function call(db,method,body,extraEnv={}) {
+ return developmentTasksRoute(new Request('https://workspace.test/api/development-tasks',{
+  method,headers:{'Content-Type':'application/json'},...(body?{body:JSON.stringify(body)}:{})
+ }),{DB:db,...extraEnv},json,'synthetic-owner');
+}
+async function state(db) {return (await (await call(db,'GET')).json());}
+function event(extra={}) {
+ return {id:'synthetic-send-start',stepId:'synthetic-send-step',
+  companyKey:'synthetic-unknown-company',groupKey:'synthetic-unknown-group',
+  channel:'email',kind:'send_started',operation:'send',
+  reference:'local-only/send-attempt/unknown',...extra};
+}
+async function fixture(db,id='resume-regression-goal',status='blocked') {
+ const goal={id,goal:'Two synthetic customers for local recovery regression only',
+  market:'GCC',target:2,kind:'develop',mode:'auto',model:'codex',authorizedSend:true};
+ assert.equal((await call(db,'POST',goal)).status,200);
+ if(status==='queued')return (await state(db)).tasks.find(task=>task.id===id);
+ assert.equal((await call(db,'PATCH',{id,action:'claim',executor})).status,200);
+ assert.equal((await call(db,'PATCH',{id,action:'execution_steps',executor,
+  steps:[{id:'synthetic-send-step',companyKey:'synthetic-unknown-company',
+   groupKey:'synthetic-unknown-group',channel:'email',operation:'send'}]})).status,200);
+ assert.equal((await call(db,'PATCH',{id,action:'execution_event',executor,event:event()})).status,200);
+ assert.equal((await call(db,'PATCH',{id,action:'execution_event',executor,
+  event:event({id:'synthetic-auth-expired',stepId:'synthetic-auth-read',
+   companyKey:'synthetic-auth-check',groupKey:'synthetic-auth-check',
+   kind:'failure',operation:'read',code:'authorization_expired',
+   reference:'local-only/session/expired'})})).status,200);
+ const checkpoint=status==='completed'?{status,completedCount:2,evidence:receipts}:
+  {status:status==='cancelled'?'blocked':status,completedCount:1,evidence:[receipts[0]]};
+ assert.equal((await call(db,'PATCH',{id,action:'result',executor,
+  summary:'Synthetic checkpoint; not real customer development',...checkpoint})).status,200);
+ if(status==='cancelled')assert.equal((await call(db,'PATCH',{id,action:'cancel'})).status,200);
+ return (await state(db)).tasks.find(task=>task.id===id);
+}
+async function resume(db,id,extra={}) {
+ return call(db,'PATCH',{id,action:'resume',executor,reference,...extra});
+}
+async function mcp(db,method,params={},authenticated=true) {
+ const response=await taskMcp(new Request('https://workspace.test/mcp',{
+  method:'POST',headers:{'Content-Type':'application/json',
+   ...(authenticated?{'oai-authenticated-user-id':'synthetic-owner'}:{})},
+  body:JSON.stringify({jsonrpc:'2.0',id:1,method,params})
+ }),{DB:db},json);
+ return {httpStatus:response.status,payload:await response.json()};
+}
+
+test('blocked resume preserves every execution field and writes one referenced recovery event',async()=>{
+ const db=createDatabase();try {
+  const before=await fixture(db),revision=(await state(db)).revision;
+  const response=await resume(db,before.id);
+  assert.equal(response.status,200);
+  const result=await response.json(),after=result.task;
+  assert.equal(result.sendPerformed,false);
+  assert.equal(Object.hasOwn(result,'delivery'),false);
+  assert.equal(after.status,'running');
+  for(const field of ['id','request','completedCount','evidence','execution',
+   'executionSteps','startedAt','createdAt','executor'])assert.deepEqual(after[field],before[field],field);
+  assert.equal(result.revision,revision+1);
+  assert.equal(after.recovery.reference,reference);
+  assert.equal(after.recovery.previousStatus,'blocked');
+  assert.ok(Number.isFinite(Date.parse(after.recovery.resumedAt)));
+  assert.equal(after.history.length,before.history.length+1);
+  assert.deepEqual(after.history.slice(0,-1),before.history);
+  const recoveryEvent=after.history.at(-1);
+  assert.equal(recoveryEvent.type,'resumed');
+  assert.equal(recoveryEvent.reference,reference);
+  assert.equal(recoveryEvent.status,'running');
+  assert.equal(recoveryEvent.completedCount,1);
+  assert.deepEqual(recoveryEvent.evidence,before.evidence);
+  assert.ok(Number.isFinite(Date.parse(recoveryEvent.occurredAt)));
+ } finally {db.close();}
+});
+
+test('resume validates bounded non-secret evidence references without changing the blocked task',async()=>{
+ const db=createDatabase();try {
+  const before=await fixture(db),snapshot=await state(db);
+  for(const invalid of [undefined,null,0,{},'', '   ','x'.repeat(241),
+   'password=synthetic-secret','api_key=synthetic-secret','Bearer synthetic-secret',
+   'sk-syntheticsecret123456789']) {
+   assert.equal((await resume(db,before.id,{reference:invalid})).status,400,String(invalid));
+   const after=await state(db);
+   assert.equal(after.revision,snapshot.revision);
+   assert.deepEqual(after.tasks,snapshot.tasks);
+  }
+ } finally {db.close();}
+});
+
+test('only the original executor may resume a blocked task',async()=>{
+ const db=createDatabase();try {
+  const before=await fixture(db),snapshot=await state(db);
+  for(const impostor of ['attacker',undefined,'']) {
+   assert.equal((await resume(db,before.id,{executor:impostor})).status,409);
+   assert.deepEqual((await state(db)).tasks,snapshot.tasks);
+  }
+  assert.equal((await resume(db,before.id)).status,200);
+ } finally {db.close();}
+});
+
+test('queued, completed, failed and cancelled tasks cannot be resumed',async()=>{
+ for(const status of ['queued','completed','failed','cancelled']) {
+  const db=createDatabase();try {
+   const before=await fixture(db,'resume-terminal-'+status,status),snapshot=await state(db);
+   assert.equal((await resume(db,before.id)).status,409,status);
+   assert.equal((await state(db)).revision,snapshot.revision);
+   assert.deepEqual((await state(db)).tasks,snapshot.tasks);
+  } finally {db.close();}
+ }
+});
+
+test('another running task blocks resume without changing either task',async()=>{
+ const db=createDatabase();try {
+  const before=await fixture(db),other=await fixture(db,'resume-other-running','running');
+  const snapshot=await state(db);
+  assert.equal(other.status,'running');
+  assert.equal((await resume(db,before.id)).status,409);
+  assert.equal((await state(db)).revision,snapshot.revision);
