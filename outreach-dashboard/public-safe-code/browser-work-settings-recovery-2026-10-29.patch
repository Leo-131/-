diff --git a/tests/browser-recovery-executor.test.mjs b/tests/browser-recovery-executor.test.mjs
--- a/tests/browser-recovery-executor.test.mjs
+++ b/tests/browser-recovery-executor.test.mjs
@@ -193 +193,84 @@ test('a Runtime read deadline cannot release an unresolved checkpoint write or u
 });
+
+const settingsDisabledDiagnostic='Browsers: Error: Local browser use is disabled in Work settings';
+let settingsFixtureNumber=0;
+function settingsFixture() {
+ const f=fixture(),browserId='settings-denial-iab-'+settingsFixtureNumber++;
+ f.input.inventory=[{id:browserId,type:'iab'}];
+ f.input.checkpoint={...checkpoint,browserId};
+ return f;
+}
+function assertSettingsDenial(result) {
+ assert.equal(result.status,'manual_verification_required');
+ assert.equal(result.code,'browser_disabled_by_settings');
+ assert.equal(result.userAction,'enable_local_browser_use_in_work_settings');
+ assert.equal(result.retryAllowed,false);assert.equal(result.fallbackAllowed,false);
+ assert.equal(result.maySend,false);assert.equal(result.sendPerformed,false);
+ assert.equal(result.historyRecheckRequired,true);
+}
+
+test('a current Work settings denial stops before every host callback and preserves attempted flags',async()=>{
+ for(const error of [settingsDisabledDiagnostic,new Error(settingsDisabledDiagnostic),'browser_disabled_by_settings']) {
+  for(const attempts of [{focusAttempted:false,submitAttempted:false},
+   {focusAttempted:true,submitAttempted:false},{focusAttempted:true,submitAttempted:true}]) {
+   for(const surface of ['iab','dedicated-chrome','empty']) {
+    const f=settingsFixture();f.input.error=error;
+    f.input.checkpoint={...f.input.checkpoint,...attempts};
+    if(surface==='dedicated-chrome') {
+     f.input.requestedBrowser='dedicated-chrome';
+     f.input.inventory=[{id:f.input.checkpoint.browserId,type:'extension',
+      metadata:{extensionInstanceId:'0792bf78-fb6c-436c-a1c6-eaa2994a2d8e'}}];
+    }else if(surface==='empty')f.input.inventory=[];
+    const before=structuredClone(f.input.checkpoint),result=await executeLoginRecovery(f.input);
+    assertSettingsDenial(result);
+    assert.deepEqual(result.checkpoint,before);assert.deepEqual(f.input.checkpoint,before);
+    assert.deepEqual(f.calls,[]);assert.deepEqual(f.saved,[]);
+   }
+  }
+ }
+});
+
+test('an explicit Work settings denial is retained even when no browser adapter is available',async()=>{
+ const f=settingsFixture();f.input.error=settingsDisabledDiagnostic;
+ f.input.checkpoint={...f.input.checkpoint,focusAttempted:true,submitAttempted:true};
+ const before=structuredClone(f.input.checkpoint),result=await executeLoginRecovery({...f.input,adapter:undefined});
+ assertSettingsDenial(result);assert.deepEqual(result.checkpoint,before);
+ assert.deepEqual(f.calls,[]);assert.deepEqual(f.saved,[]);
+});
+
+test('a Work settings denial never replays an unknown send or resets its login checkpoint',async()=>{
+ for(const sendState of ['send_unconfirmed','send_clicked_outcome_unknown_do_not_resend']) {
+  const f=settingsFixture();f.input.checkpoint={...f.input.checkpoint,focusAttempted:true,submitAttempted:true};
+  const before=structuredClone(f.input.checkpoint),result=await executeLoginRecovery({...f.input,
+   sendState,error:settingsDisabledDiagnostic});
+  assert.ok(['manual_verification_required','reconcile_sent_only'].includes(result.status));
+  if(result.status==='manual_verification_required')assertSettingsDenial(result);
+  assert.equal(result.maySend,false);assert.equal(result.sendPerformed,false);
+  assert.deepEqual(result.checkpoint,before);assert.deepEqual(f.calls,[]);assert.deepEqual(f.saved,[]);
+ }
+});
+
+test('actual inspect and account-verification Work settings denials keep their classification',async()=>{
+ for(const error of [settingsDisabledDiagnostic,new Error(settingsDisabledDiagnostic),'browser_disabled_by_settings']) {
+  for(const stage of ['inspect','verifySession']) {
+   const f=settingsFixture();f.input.checkpoint={...f.input.checkpoint,focusAttempted:true,submitAttempted:true};
+   f.adapter.inspect=async()=>{
+    f.calls.push('inspect');if(stage==='inspect')throw error;
+    return {origin,authorizedSameOrigin:true,formVisible:false,authenticated:true,challenge:'none'};
+   };
+   f.adapter.verifySession=async()=>{f.calls.push('verify');throw error;};
+   const before=structuredClone(f.input.checkpoint),result=await executeLoginRecovery(f.input);
+   assertSettingsDenial(result);assert.deepEqual(result.checkpoint,before);assert.deepEqual(f.saved,[]);
+   assert.deepEqual(f.calls,stage==='inspect'?['inspect']:['inspect','verify']);
+  }
+ }
+});
+
+test('without an explicit denial an empty host inventory remains a connection problem',async()=>{
+ const f=settingsFixture(),before=structuredClone(f.input.checkpoint);
+ const result=await executeLoginRecovery({...f.input,inventory:[]});
+ assert.equal(result.status,'connection_required');assert.notEqual(result.code,'browser_disabled_by_settings');
+ assert.notEqual(result.userAction,'enable_local_browser_use_in_work_settings');
+ assert.equal(result.maySend,false);assert.equal(result.sendPerformed,false);
+ assert.deepEqual(result.checkpoint,before);assert.deepEqual(f.calls,[]);assert.deepEqual(f.saved,[]);
+});
