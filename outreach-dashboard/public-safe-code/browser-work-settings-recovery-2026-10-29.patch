+ for(const message of [settingsDisabledDiagnostic,'Local browser use is disabled in Work settings',
+  'browser_disabled_by_settings']) {
+  for(const error of [message,new Error(message)])
+   assert.equal(classifyBrowserError(error),'browser_disabled_by_settings');
+ }
+ assert.equal(classifyBrowserError('browser_execution_tool_unavailable'),'tool_unavailable');
+});
+
+test('a Work settings denial vetoes stale browser selection and pending recovery without fallback',()=>{
+ for(const error of [settingsDisabledDiagnostic,new Error(settingsDisabledDiagnostic),'browser_disabled_by_settings']) {
+  for(const inventory of [[],[dedicated],[{id:'old-iab',type:'iab'},dedicated]]) {
+   for(const requestedBrowser of [null,'iab','dedicated-chrome']) {
+    for(const pending of [{},{recoveryState:'pending',recoveryHandle:{id:'old-operation',live:true}}]) {
+     const result=recoveryDecision({inventory,error,requestedBrowser,...pending});
+     assert.equal(result.action,'handoff_required');
+     assert.equal(result.code,'browser_disabled_by_settings');
+     assert.equal(result.userAction,'enable_local_browser_use_in_work_settings');
+     assert.equal(result.browserId,null);assert.equal(result.extensionInstanceId,null);
+     assert.equal(result.retryAllowed,false);assert.equal(result.fallbackAllowed,false);
+     assert.equal(result.maySend,false);
+    }
+   }
+  }
+ }
+});
+
+test('a Work settings denial cannot turn an unknown send into another browser operation',()=>{
+ for(const sendState of ['send_unconfirmed','send_clicked_outcome_unknown_do_not_resend']) {
+  const result=recoveryDecision({inventory:[dedicated,{id:'old-iab',type:'iab'}],
+   error:settingsDisabledDiagnostic,sendState,recoveryState:'pending',
+   recoveryHandle:{id:'old-operation',live:true}});
+  assert.equal(result.action,'handoff_required');assert.equal(result.code,'browser_disabled_by_settings');
+  assert.equal(result.browserId,null);assert.equal(result.maySend,false);
+  assert.equal(result.retryAllowed,false);assert.equal(result.fallbackAllowed,false);
+ }
+});
+
+test('an empty inventory alone does not imply that Work settings disabled browser use',()=>{
+ for(const error of [null,undefined,'empty_tabs']) {
+  const result=recoveryDecision({inventory:[],error});
+  assert.equal(result.action,'await_connection');assert.equal(result.browserId,null);
+  assert.notEqual(result.code,'browser_disabled_by_settings');
+  assert.notEqual(result.userAction,'enable_local_browser_use_in_work_settings');
+ }
+ for(const diagnostic of ['Browser settings are unavailable',
+  'Local browser use is disabled on this website','browser disabled by an unknown extension'])
+  assert.equal(classifyBrowserError(diagnostic),'unknown_failure');
+});
